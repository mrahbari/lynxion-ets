#!/usr/bin/env zsh
# Lynxion Trading System - Fast Production Auto-Detect Runner
set -euo pipefail

set +e
pgrep -f "[p]ython .*run_trading_system.py --mode production --auto-detect" >/dev/null
runner_lookup_status=$?
set -e
if [[ ${runner_lookup_status} -eq 0 ]]; then
  print -u2 "Lynxion auto-detect runner is already active; refusing to start a duplicate."
  exit 1
elif [[ ${runner_lookup_status} -ne 1 ]]; then
  print -u2 "Unable to verify runner uniqueness; refusing to start fail-closed."
  exit 1
fi

evidence_root="${LYNXION_FORWARD_EXIT_ROOT_OVERRIDE:-data/observability/forward_exit}"
head_commit="$(git rev-parse HEAD)"
candidate_run_id="task0155-$(date -u +%Y%m%dT%H%M%SZ)"
candidate_boundary="$(python -c 'from datetime import datetime,timezone; print(datetime.now(timezone.utc).isoformat())')"
resolver_args=(
  --root "${evidence_root}"
  --head "${head_commit}"
  --new-run-id "${candidate_run_id}"
  --new-boundary-utc "${candidate_boundary}"
)
if [[ -z "${LYNXION_FORWARD_EXIT_ROOT_OVERRIDE:-}" ]]; then
  resolver_args+=(--auto-rotate-commit-mismatch)
fi
launch_metadata="$(python scripts/resolve_forward_exit_cohort.py "${resolver_args[@]}")"

evidence_root="$(python -c 'import json,sys; print(json.loads(sys.argv[1])["root"])' "${launch_metadata}")"
cohort_run_id="$(python -c 'import json,sys; print(json.loads(sys.argv[1])["run_id"])' "${launch_metadata}")"
cohort_boundary="$(python -c 'import json,sys; print(json.loads(sys.argv[1])["activation_boundary_utc"])' "${launch_metadata}")"
cohort_commit="$(python -c 'import json,sys; print(json.loads(sys.argv[1])["commit"])' "${launch_metadata}")"

env \
  LOG_LEVEL=WARNING \
  RISK_MAX_LEVERAGE=10 \
  MAX_LEVERAGE=10 \
  LYNXION_FORWARD_EXIT_OBSERVER_ENABLED=true \
  LYNXION_FORWARD_EXIT_ROOT="${evidence_root}" \
  LYNXION_FORWARD_EXIT_RUN_ID="${cohort_run_id}" \
  LYNXION_FORWARD_EXIT_BOUNDARY_UTC="${cohort_boundary}" \
  LYNXION_FORWARD_EXIT_COMMIT="${cohort_commit}" \
  python run_trading_system.py --mode production --auto-detect "$@"
