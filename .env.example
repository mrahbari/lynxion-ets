CMC_EXCLUDED_COINS=BTC,ETH,SOL,ADA,DOT,XRP,DOGE,LINK,BNB,AVAX,MATIC

# API Rate Limiting Configuration (for basic/trial tiers)
CMC_MAX_CALLS_PER_MINUTE=10
CMC_MAX_CALLS_PER_HOUR=300
CMC_API_CALL_INTERVAL=4.0
CMC_CACHE_TTL_SECONDS=300
CMC_LISTINGS_CACHE_TTL_SECONDS=1800  # Cache listings longer (30 minutes) - slower changing data
CMC_QUOTE_CACHE_TTL_SECONDS=300       # Cache quotes shorter (5 minutes) - more volatile data

# Rate limiting for different operations
CMC_SCREEN_TOP_COINS_INTERVAL_HOURS=1  # Only fetch top coins once per hour
CMC_SCREEN_TOP_COINS_LIMIT=50          # Only screen top 50 coins
CMC_MAX_COINS_TO_ANALYZE_PER_RUN=20    # Limit number of coins analyzed per screening run

# Circuit Breaker Configuration
CMC_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CMC_CIRCUIT_BREAKER_RESET_TIMEOUT=600  # 10 minutes before retrying