##############################
# WALK-FORWARD OPTIMIZATION CONFIGURATION
##############################
# WFO Pipeline Parameters
WFO_TRAIN_SIZE=90                    # Training window size in days (3 months)
WFO_TEST_SIZE=30                     # Testing window size in days (1 month)
WFO_STEP_SIZE=30                     # Sliding step size in days (1 month)
WFO_MAX_EVALS=50                     # Maximum hyperopt evaluations per asset
WFO_PERFORMANCE_THRESHOLD=0.1        # Minimum Sharpe ratio to continue WFO period
WFO_MAX_DRAWDOWN_THRESHOLD=0.15      # Maximum acceptable drawdown (15%)
WFO_RETRAIN_FREQUENCY_DAYS=30        # How often to retrain the model (in days)

# Advanced WFO parameters
WFO_MIN_TRAINING_POINTS=30            # Minimum data points for training window
WFO_MIN_TESTING_POINTS=10             # Minimum data points for testing window
WFO_OVERFIT_THRESHOLD=1.0             # Threshold for flagging potential overfitting
WFO_CONSISTENCY_THRESHOLD=0.60        # Minimum consistency score to accept optimization
WFO_PASS_RATE_THRESHOLD=0.60          # Minimum pass rate across WFO windows

