OPTIMIZATION_MIN_SHARPE_RATIO=0.1      # Minimum Sharpe ratio for valid optimizations
OPTIMIZATION_MAX_DRAWDOWN=0.15         # Maximum drawdown allowed in optimization
OPTIMIZATION_MIN_WIN_RATE=0.40         # Minimum win rate for valid optimizations

