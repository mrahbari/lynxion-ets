##############################
# BASIC SYSTEM SETTINGS
##############################
DEFAULT_BROKER=bingx
LOG_LEVEL=INFO
ENVIRONMENT=production

##############################
# STRATEGY SETTINGS
##############################
# Minimum confidence threshold for execution (0.0 to 1.0)
STRATEGY_MIN_CONFIDENCE_THRESHOLD=0.5
# Maximum position size relative to account equity (e.g., 0.05 = 5%)
STRATEGY_MAX_POSITION_SIZE=0.05
# Risk percentage allocated per trade (e.g., 0.02 = 2%)
STRATEGY_RISK_PER_TRADE=0.02

##############################
# POSITION SIZING SETTINGS
##############################
# Enable/disable fixed position sizing (true/false)
FIXED_POSITION_SIZE_ENABLED=true
# Fixed currency/dollar amount per trade (e.g., 4.0 USDT)
FIXED_POSITION_AMOUNT=4.0
# Maximum currency/dollar amount per trade (e.g., 50.0 USDT)
MAX_ORDER_NOTIONAL_AMOUNT=10.0

##############################
# BACKTESTING & COST MODELING
##############################
# Fee rate (e.g., 0.001 = 0.1%)
BACKTEST_FEE_RATE=0.001
# Slippage factor (e.g., 0.0005 = 0.05%)
BACKTEST_SLIPPAGE_FACTOR=0.0005

# Volatility-Adapted SL/TP Parameters (Phase 11)
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
MIN_STOP_DISTANCE_PERCENT=0.8
MIN_REWARD_RISK_RATIO=1.5
ENABLE_DYNAMIC_TP=true
REJECT_LOW_RR_SETUP=true

# Per-Symbol Stop Loss Cooldown (Roadmap: Re-Entry After Stop Loss - Set to 0 to disable)
ENABLE_SYMBOL_STOPLOSS_COOLDOWN=true
SYMBOL_STOPLOSS_COOLDOWN_MINUTES=60

# Max Portfolio Concurrent Open Positions Across Different Symbols
MAX_TOTAL_POSITIONS=50

# Persistent Research Trade Journal & Feature Collector (true/false)
TRADE_JOURNAL_COLLECTOR_ENABLED=true
